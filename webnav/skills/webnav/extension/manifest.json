{
	"manifest_version": 3,
	"name": "WebNav - AI Browser Control",
	"version": "1.7.0",
	"description": "Enables AI agents to navigate, interact with, and control browser tabs via native messaging",
	"permissions": [
		"activeTab",
		"tabs",
		"nativeMessaging",
		"scripting",
		"storage",
		"tabGroups",
		"debugger"
	],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
