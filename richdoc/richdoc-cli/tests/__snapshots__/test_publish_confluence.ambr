                  <h2>Sparklines</h2>
                  <p>Tiny inline trends share the chart engine via <code>&lt;rd-chart variant="sparkline"&gt;</code> — stripped of axes, titles, legends. They render in tables, in prose, or inside <code>rd-stat</code>. Latency last 30 days: . Signups: .</p>
                </ac:layout-cell>
              </ac:layout-section>
              <ac:layout-section ac:type="three_equal" ac:breakout-mode="default">
                <ac:layout-cell>
                  <ac:adf-extension>
                    <ac:adf-node type="panel">
                      <ac:adf-attribute key="panel-type">note</ac:adf-attribute>
                      <ac:adf-content>
                        <p>
                          <strong>42K</strong>
                        </p>
                        <p>Active users <em>(▲ +12% MoM)</em></p>
                      </ac:adf-content>
                    </ac:adf-node>
                  </ac:adf-extension>
                </ac:layout-cell>
                <ac:layout-cell>
                  <ac:adf-extension>
                    <ac:adf-node type="panel">
                      <ac:adf-attribute key="panel-type">note</ac:adf-attribute>
                      <ac:adf-content>
                        <p>
                          <strong>99.94</strong>
                        </p>
                        <p>Uptime % <em>(→)</em></p>
                      </ac:adf-content>
