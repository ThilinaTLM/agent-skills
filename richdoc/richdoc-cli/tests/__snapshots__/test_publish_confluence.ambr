                            <strong>Query params</strong>
                          </p>
                        </th>
                        <td>
                          <ul>
                            <li><code>strict</code><code>boolean</code> default <code>false</code> — Treat warnings as errors.</li>
                          </ul>
                        </td>
                      </tr>
                      <tr>
                        <th>
                          <p>
                            <strong>Headers</strong>
                          </p>
                        </th>
                        <td>
                          <ul>
                            <li><code>X-Trace-Id</code><code>string</code> — Optional client-supplied trace identifier.</li>
                          </ul>
                        </td>
                      </tr>
                      <tr>
                        <th>
                          <p>
                            <strong>Body</strong>
                          </p>
                        </th>
