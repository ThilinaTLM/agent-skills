  dict({
    'assets': 0,
    'book': False,
    'chapters': list([
      'out.md',
    ]),
    'dropped': list([
      'rd-chart',
      'rd-icon',
      'rd-toc',
    ]),
    'input': 'showcase.html',
    'missing': list([
    ]),
    'mode': 'single',
    'ok': True,
    'output': 'out.md',
  })
# ---
# name: test_export_md_single_file[showcase.html][showcase.html-md]
