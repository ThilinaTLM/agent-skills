{
	"name": "richdoc-lib",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Framework for AI-authored HTML documents",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"build": "tsx build.ts",
		"build:dev": "tsx build.ts --dev",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.9.0",
		"esbuild": "^0.24.0",
		"lucide-static": "1.16.0",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
	}
}
